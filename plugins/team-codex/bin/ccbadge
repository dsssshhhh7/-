#!/bin/bash
# ccbadge —— 状态栏上那一小块：这个窗口在协作里的代号
#
#   ccbadge            输出 {"label":"安卓"}（claude-hud 的额外标签要这个格式）
#   ccbadge --文字      只输出代号本身，给别的底座拼接用
#
# 没登记过代号就显示「代号未登记」—— 不是留空。
# 留空的话你看不出是"这个窗口没进协作"还是"状态栏坏了"，而这两件事该分得清。
#
# ⚠️ 必须快：状态栏每 300 毫秒刷一次。所以这里【只读索引文件】，
#    绝不去查谁在线（查在线要调 Claude Code 自己的命令，几百毫秒，会把状态栏拖死）。

# 会话编号从哪来，按可靠程度排：
#   1. TEAM_HUD_SID —— ccstatusline 从状态栏送进来的那份数据里取出来的，最准
#   2. CLAUDE_CODE_SESSION_ID —— 环境变量里有就用
#   3. 都没有 → 下面按工作目录反查（同一目录开了多个窗口时会认错，只作兜底）
SID="${TEAM_HUD_SID:-${CLAUDE_CODE_SESSION_ID:-}}"
export CLAUDE_CODE_SESSION_ID="${SID}"

# lib.sh 默认拿不到会话编号就当场退出（防止会话外误用把数据写坏）。
# 状态栏这块要走那个后门：它不写任何东西，只读索引；而且**恰恰在拿不到编号的时候
# 也得说句话**（说「代号未登记」），不能整块消失 —— 消失了人只会以为状态栏坏了。
export TEAM_SKIP_SESSION_CHECK=1

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

MODE="json"
[ "$1" = "--文字" ] || [ "$1" = "--text" ] && MODE="text"

ALIAS=""
[ -n "${SID}" ] && ALIAS="$(t_alias_of "${SID}" 2>/dev/null)"

# 兜底：按工作目录去索引里反查。
#
# ⚠️ 只在【连会话编号都拿不到】的时候才走这条路。
#    编号拿到了、但索引里查不到代号 —— 那答案就是「这个窗口没登记」，到此为止，不许再猜。
#    这两种情况必须分开：踩过一次，条件写成了「没查到代号」，结果一个刚开的新窗口
#    因为跟一条已关闭的旧记录同目录，状态栏上顶着别人的代号显示「总控?」。
#    编号明明是准的，却去猜了个错答案 —— 猜的前提是没有准的，有准的就不该猜。
#
# 猜出来的后面加问号：同一个目录可能开着好几个窗口，而代号是一个窗口一个，
# 所以这时候只能说「这个目录上挂着这个代号」，不能断定就是当前这个窗口。
if [ -z "${SID}" ] && [ -f "${INDEX_FILE}" ]; then
  BY_DIR="$(awk -F'|' -v d="${PWD}" '
    /^\|/ {
      for (i = 2; i <= NF; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
      if ($2 == "会话编号" || $2 ~ /^-+$/ || $2 == "") next
      if ($5 == d) { print $3; exit }
    }' "${INDEX_FILE}" 2>/dev/null)"
  [ -n "${BY_DIR}" ] && ALIAS="${BY_DIR}?"
fi

[ -n "${ALIAS}" ] || ALIAS="代号未登记"

if [ "${MODE}" = "text" ]; then
  printf '%s\n' "${ALIAS}"
  exit 0
fi

# JSON 里的引号和反斜杠要转义，否则 claude-hud 那边解析不了就整块不显示
ESC="$(printf '%s' "${ALIAS}" | sed 's/\\/\\\\/g; s/"/\\"/g')"
printf '{"label":"%s"}\n' "${ESC}"
