#!/bin/bash
# ccindex —— 把共识里「互相引用的条目」摆出来，提示该连读哪几组
#
#   ccindex <组名>
#
# 这东西要解决什么：
#   共识的设计前提是「中途加入的人只读这一份就能追上进度」。10 条时成立，
#   40 条时不成立了 —— **同一件事往往拆在四五条里各说一面，读的人只读到一条。**
#
#   实测中这个形态造成过四类问题（同一个组、同一天）：
#     · 「锁屏」散在 4 条 → 其中两条互相矛盾，谁都没发现
#     · 「整个不发」在前、「只针对这一个消息类型」在后 → 只读前面会以为是全局停发
#     · 「未读已读」4 条其实是一根因果链 → 单看后两条像可选优化，实现时容易省掉
#     · 「按版本卡通知栏」在 3 条里各作废一次 → 读的人不知道现状是什么
#
# 怎么找出「该连读的组」—— 试错过两版，记下来免得后人重走：
#   ① 只取被加粗或「」包住的短语 → **不合格**。找出来的是示例文案（「张三 评论了你的
#      拜访」跨 7 条）和太泛的词（「拜访评论」「消息」），而真正散落的那几个
#      （锁屏、左滑、版本闸门）一个都没找到 —— 它们在正文里是裸词。
#   ② 统计所有 2-6 字中文词组 → **更差**。滑窗切出的全是碎片（「务端」「为什」「的是」），
#      而「手机」「拜访」跨 20 多条、毫无信息量。
#
#   两版失败在同一处：**都在让脚本判断「什么是重要概念」，而这件事它做不了。**
#
#   现在的做法：**不猜，只报事实 —— 找条目里显式写下的交叉引用**
#   （「见架构设计那条」「别与另一条混」「见下方」…）。这些是条目作者主动写的
#   「这条跟另一条有关」，**是人留下的信号，不是脚本的猜测**，而且实测中它们
#   指向的正是出问题的那几组。
#
# ⚠️ 这个命令查得出「哪几条互相牵连」，查不出「它们矛不矛盾」。
#   矛盾要靠人把那几条**连起来读**才能发现（实测中两处矛盾正是这么查出来的）。
#   本命令只告诉你该连读哪几组，替代不了阅读。

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
t_ensure_skeleton

G="$1"; shift 2>/dev/null
[ -n "$G" ] || t_die "用法：ccindex <组名>"
t_group_exists "$G" || t_die "没有这个组：$G"

CF="$(t_group_consensus "$G")"
[ -f "$CF" ] || t_die "这个组还没有共识文件"

TOTAL=$(grep -c '^【' "$CF" 2>/dev/null | tr -d ' ')
echo "【${G}】共识交叉引用检查　（共 ${TOTAL} 条）"
echo

# 找条目里显式写下的交叉引用
#
# 这里原先调 python3。公司 Windows 上 python3 是个应用商店占位程序 ——
# 它什么都不做就退出，于是这条命令永远输出「没有交叉引用」，看着像一切正常，
# 其实一条都没查。（同样的坑在 ccstatus --已问 那里踩过一次。）
# 改成 awk：本机制别处已经全靠 awk，没有新增依赖。中文直接写字面量，别用转义。
awk '
  function trim(x) { gsub(/^[ \t]+|[ \t]+$/, "", x); return x }
  /^## / { sec = trim(substr($0, 4)); next }
  # ⚠️ 别用 substr + 位置算术来剥这对中文括号：
  #    macOS 自带的 awk 按**字节**数位置，Windows 的 gawk 按**字符**数位置，
  #    同一句 substr($0, 4, p-4) 在两边算出的东西不一样 —— 实测 Windows 上算成空字符串，
  #    于是条目名为空、整段逻辑被静默跳过，这条命令永远报「没有交叉引用」。
  #    用正则删头删尾，两种语义下结果一致。
  /^【/  { item = $0; sub(/^【/, "", item); sub(/】.*$/, "", item); itemsec = sec; next }
  item == "" { next }
  {
    line = $0
    while (match(line, /见架构设计|见技术设计|见验收口径|见明确不做|见分工|见需求澄清|见已作废|见「架构设计|见「技术设计|另一条共识|另一条|见下方|见上面|前面那条|那一条共识|见共识/)) {
      ref = substr(line, RSTART, RLENGTH)
      key = item "|" ref
      if (!(key in seen)) { seen[key] = 1; n++; secs[n] = itemsec; its[n] = item; refs[n] = ref }
      line = substr(line, RSTART + RLENGTH)
    }
  }
  END {
    if (n == 0) { print "  ✅ 共识条目之间没有显式的交叉引用 —— 目前不需要建索引。"; exit }
    printf "  ⚠️  下面 %d 处是条目作者自己写下的「这条跟另一条有关」，\n", n
    print  "     **把每一对连起来读一遍** —— 今天两处矛盾正是这么查出来的：\n"
    for (i = 1; i <= n; i++) {
      printf "    · 【%s】%s\n", secs[i], its[i]
      printf "        └─ 里面写着「%s」，去把它指的那条一起读\n\n", refs[i]
    }
  }
' "$CF"

echo
echo "──────────────────────────────────────────"
echo "  怎么用这个结果："
echo "    ① 把上面每组涉及的条目**连起来读一遍** —— 查矛盾只能靠这一步，本命令查不出来。"
echo "    ② 在共识顶部建一份索引，写明「这件事要一起读哪几条」。"
echo "    ③ 连读时**特意往「两个负责人中间那块」看**。"
echo
echo "       实测：三个端各自照索引连读了一遍，三次都查出真漏项，而且**漏的全是**"
echo "       **「前提」不是「实现」**，还都卡在交界处 —— 一个漏的是自己和后端之间的归属，"
echo "       一个漏的是自己和另一个端之间的约定（九处做法都写了，没一处写明「这是两端共同的」）。"
echo
echo "       **越是跨在两个人中间的东西，越没人写**：它不属于任何一方的实现清单，"
echo "       双方都觉得对方会写。只说「连读一遍」，下一个人会走过场；说清往哪儿看才有用。"
echo
echo "    ④ 特别防这一种：**每个字都没错，错的是它隐含的前提**。"
echo
echo "       实测同一天出现三次，三次都长一样 ——"
echo "         · 「每个人各自的编号怎么区分」：没错，但预设了每人一个编号，最终定的是共享一个"
echo "         · 「端上不做判断、原样透传」：没错，但预设了地址由推送带，实际是点击时才给"
echo "         · 「点击那一刻判权限」：没错，但预设了列表上不必预先知道权限，而设计图上要求显示"
echo
echo "       **这类条目用关键词搜不出来** —— 搜「地址」搜不到第二条，因为它压根没提「地址」。"
echo "       **只有把它和后来的决定摆在一起读，才会发现前提已经变了。**"
echo "       本命令给的就是「该摆在一起读的是哪几条」，治的正是这一种。"
echo
echo "  ⚠️ 本命令治不了的那一种，用另一个办法："
echo
echo "     它只找**条目之间**的交叉引用。**同一份文档内部自相矛盾，它一个都查不出来。**"
echo
echo "     实测：某端的设计文档里，同一件事在 §1.2 写成一个说法、在 §5.2 和 §9.4.1 写成另一个，"
echo "     **在同一份文档里躺了一整晚没人发现** —— 作者自己写的，自己读了很多遍。"
echo
echo "     **撞出它的动作是：把文档逐条转写成「可以拿去验收的标准」。**"
echo "     转写时每一条都要落成一句「做完之后应该看到什么」，"
echo "     **同一件事的两个说法会落成两句互相打架的验收标准，当场就露馅。**"
echo
echo "     通读多少遍都不行 —— 通读时大脑会自动把两处调和掉；**转写会强迫你二选一。**"
echo
echo "  ⚠️ 索引的两条硬规矩："
echo "    · **索引里不许出现任何新的约定**，只能引用已有条目 —— 否则它会变成"
echo "      绕过核对门槛的后门：没人核对过的内容塞进索引，照样被当成共识读。"
echo "    · **索引不写行号**，只写「哪一节的哪条」—— 条目会增删移动，"
echo "      写行号必然失效，而**失效的索引比没有索引更糟**，它会把人指到错的地方。"
