#!/bin/bash
# ccpin —— 把一条【人已经同意的】结论写进共识
#
#   ccpin <组名> "内容" --节 <分节名> --核对 已
#
# ⚠️ 铁律：共识里只能装人同意过的内容。
#
#   AI 成员自己得出的结论，无论多有把握、无论其他成员是否附议、无论全组是否
#   一致同意，都【不能】直接写进共识 —— 必须先拿到人的同意。
#
#   为什么这条是硬的：共识是"当前有效的约定"，中途加入的人只读这一份就当真。
#   一条 AI 自己写进去的结论，和一条人拍板的结论，在文件里长得一模一样，
#   后来的人分辨不出来。真实事故：一个 AI 提议、另一个 AI 同意，就把一条人从未
#   点头的架构选择写成了共识地基，四个端在上面盖了一个半小时，方向是反的。
#
#   所以 --人已同意 这个参数不是形式，是让你把"人同意过"这件事【显式说出来】。
#   没拿到人的同意就别写，用 cctell 发到组里讨论，或者挂着等人答复。
#
# 共识是「当前有效的约定」，不是流水账。中途加入的人只读这一份就要能追上进度。
# 所以：如果这条是【修改】已有约定（比如字段改名），不要只追加 ——
# 会话应该直接编辑共识文件，把旧的那条改掉，否则会留下两份互相矛盾的说法。

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
t_ensure_skeleton

# 组名和正文按出现顺序取，开关放哪儿都认。
# 早先是 G="$1"; BODY="$2" 死板取前两个 —— 写成 ccpin 组 --核对 已 "正文"
# 就会把「--核对」当成正文吞进去，而 --核对 反而算没给，报的错跟真实原因对不上。
G=""; BODY=""; FLAG=""; SECTION=""; CHECKED=""
while [ $# -gt 0 ]; do
  case "$1" in
    --人已同意|--approved) FLAG="ok"; shift ;;
    --节|--section)        SECTION="$2"; shift 2 ;;
    --核对|--checked)      CHECKED="$2"; shift 2 ;;
    --*)                   t_die "不认识的参数：$1（可用：--节 / --核对 / --人已同意）" ;;
    *)  if   [ -z "$G" ];    then G="$1"
        elif [ -z "$BODY" ]; then BODY="$1"
        else t_die "多了一个参数：$1 —— 正文里有空格的话记得整段用引号括起来"
        fi; shift ;;
  esac
done
[ -n "$G" ] && [ -n "$BODY" ] || t_die "用法：ccpin <组名> \"要写进共识的结论\" --节 <分节名> --核对 已"

# ── 每条共识必须标明「人有没有逐字核对过这段文字」 ──
#
# 为什么单有 --人已同意 不够（实跑中出过）：
#   会话可以拿人拍板过的一个要点当由头，把整段自己组织的分析盖上「人已同意」写进去。
#   人说的那四个字和 AI 写的那三百字，在共识文件里长得一模一样，后来的人分不出来。
#   实跑中十条共识没有一条是逐条呈给人、人逐条表态后才写的，全都盖着「人已同意」。
#
#   「人同意这个要点」和「人逐字看过这段文字」是两件事。这个标记把它们分开。
case "$CHECKED" in
  已|已核对|yes) CHECK_MARK="✅ 已与人逐条核对（这段文字人逐字过目并认可）" ;;
  未|未核对|no)
    echo "❌ 拒绝写入：没经人逐字核对的内容，一个字都不许进共识。" >&2
    echo >&2
    echo "   「未核对」这个档位**已经取消**。原先允许标未核，结果是——" >&2
    echo "   「先写进共识、再补一句『人没逐字看过』当免责」变成了合规操作，" >&2
    echo "   而免责声明起不到免责作用：**后来的人读共识时，那段文字照样在里面当事实用。**" >&2
    echo >&2
    echo "   ── 你现在该做的（三选一）──" >&2
    echo >&2
    echo "   ① **把这整段拿给人看，拿到逐字确认**，然后用 --核对 已 写入。" >&2
    echo "      这是唯一能进共识的路。人只看了个要点、或只从几个选项里选了一句，**都不算**。" >&2
    echo >&2
    echo "   ② **先不写共识，用 cctell 发到组里讨论**，等人拍板并逐字看过再 pin。" >&2
    echo >&2
    echo "   ③ **只把人逐字定过的那一句写进去**，你的解释和理由留在消息里、不进共识。" >&2
    echo "      （人从三个候选里选了一句文案 → 那一句可以进；你围着它写的三段解释不行。）" >&2
    echo >&2
    echo "   ⚠️ **跨窗口的尤其注意**：人在别的窗口拍的板，转达进来的那个窗口" >&2
    echo "      **没有、也不可能有**那次逐字确认——人是在别人的窗口看的文字。" >&2
    echo "      想标已核对，只有一条路：把最终文本拿回给人本人再看一遍。" >&2
    exit 1
    ;;
  *)
    echo "❌ 还差一样：这条人有没有【逐字核对过】？加 --核对 已  或  --核对 未" >&2
    echo >&2
    echo "   · --核对 已 —— 这段文字**原样**呈给人看过，人逐条表过态。" >&2
    echo "   · --核对 未 —— **已取消**。没逐字确认的内容不许进共识，跑一次会告诉你该怎么办。" >&2
    echo >&2
    echo "   ⚠️ 别把「人同意这个结论」当成「人核对过这段话」。" >&2
    echo "      你完全可以拿人拍板过的一个要点当由头，把整段自己写的分析盖上「人已同意」——" >&2
    echo "      而人说的那几个字和你写的那几百字，在共识文件里长得一模一样。**这正是这个标记要拦的事。**" >&2
    echo >&2
    echo "   拿不准 = 没确认 = 不许写。去拿逐字确认，或者用 cctell 发到组里讨论。" >&2
    echo >&2
    echo "   ⚠️ 还有：这些都【不算】人同意，一条都不许往共识里写——" >&2
    echo "     · 另一个 AI 成员表示认同" >&2
    echo "     · 全组没有人反对" >&2
    echo "     · 你自己基于代码事实推出来、很有把握" >&2
    echo "     · 你问过人、但人还没回答" >&2
    echo "   代码事实（「第 40 行就是这么写的」）要沉淀，也得先问人「要不要作为本组约定」。" >&2
    echo "   真不是人同意的 → 别写共识，用 cctell 发到组里讨论，或挂着等人答复。" >&2
    exit 1
    ;;
esac

t_group_exists "$G" || t_die "没有这个组：$G"
ME="$(t_sid)"
t_is_member "$G" "$ME" || t_die "你不在【${G}】里"
ALIAS="$(t_alias_of "$ME")"

CF="$(t_group_consensus "$G")"

# 共识是分节的。没指定分节就拦下来问 —— 闷头追加会落到文件最末尾，
# 那里正好是「已作废的结论」后面，一条有效约定落在作废区后面最误导人。
if [ -z "$SECTION" ] && grep -q '^## ' "$CF"; then
  echo "❌ 还差一样：这条要写进哪一节？加 --节 <分节名>" >&2
  echo >&2
  echo "   现有分节：" >&2
  grep '^## ' "$CF" | sed 's/^## /     · /' >&2
  echo >&2
  echo "   例：ccpin \"$G\" \"...\" --节 技术设计 --核对 已" >&2
  exit 1
fi

# 正文里带行首「## 」会在共识文件里造出假分节，拦在拿锁之前
t_reject_heading "$BODY" "共识"

t_lock "组-$G" || t_die "该组文件被占用"

# 首次写入时把占位说明去掉
grep -q '^（还没有任何约定' "$CF" && {
  grep -v '^（还没有任何约定' "$CF" > "$CF.tmp.$$" && mv "$CF.tmp.$$" "$CF"
}

# 按分节插入：找到「## <分节名>」，插到它下一个「## 」之前（也就是这一节的末尾）。
#
# 为什么必须指定分节：共识是分节的（分工/需求澄清/架构设计/技术设计/明确不做的/
# 验收口径/已作废的结论）。不指定就只能追加到文件尾巴，那里正好是「已作废的结论」
# 后面 —— 一条有效约定落在作废区后面，是最容易误导人的位置。
#
# ⚠️ 绝对不要用 awk -v 传这段内容：它带换行，而 macOS 自带的 awk 不接受带换行的
#    参数，会直接报 "newline in string" 失败（退出码 2），文件一个字不改。
#    这里改用行号切分 + 拼接，纯 shell，没有这个问题。
BEFORE_BYTES=$(wc -c < "$CF" | tr -d ' ')
TMP="$CF.tmp.$$"

SEC_LINE=""
if [ -n "$SECTION" ]; then
  SEC_LINE="$(grep -n "^## ${SECTION}" "$CF" | head -1 | cut -d: -f1)"
  if [ -z "$SEC_LINE" ]; then
    t_unlock "组-$G"
    echo "❌ 共识里没有【${SECTION}】这一节。现有的是：" >&2
    grep '^## ' "$CF" | sed 's/^## /     · /' >&2
    exit 1
  fi
fi

if [ -n "$SEC_LINE" ]; then
  # 这一节的结束位置 = 它后面第一个 ## 的行号；没有就到文件尾
  NEXT="$(tail -n "+$((SEC_LINE + 1))" "$CF" | grep -n '^## ' | head -1 | cut -d: -f1)"
  if [ -n "$NEXT" ]; then END=$((SEC_LINE + NEXT)); else END=$(( $(wc -l < "$CF") + 1 )); fi
  head -n "$((END - 1))" "$CF" > "$TMP"
  # 先削掉上一段尾部的空行，写完再补一个 —— 否则条目上面空两行、
  # 而下面那个「## 某节」紧贴着核对标记，中间一个空行都没有：
  # 有些 markdown 渲染器会把那行标题吞进上面的引用块里。（测试2 窗口在验收中发现）
  awk '{ a[NR] = $0 } END { n = NR; while (n > 0 && a[n] ~ /^[[:space:]]*$/) n--
         for (i = 1; i <= n; i++) print a[i] }' "$TMP" > "${TMP}.t" && mv "${TMP}.t" "$TMP"
  printf '\n%s\n\n> %s · 由 %s 于 %s 写入\n\n' "$BODY" "$CHECK_MARK" "$ALIAS" "$(t_now)" >> "$TMP"
  tail -n "+$END" "$CF" >> "$TMP"
  mv "$TMP" "$CF"
else
  printf '\n%s\n\n> %s · 由 %s 于 %s 写入\n' "$BODY" "$CHECK_MARK" "$ALIAS" "$(t_now)" >> "$CF"
fi

# 写完必须核实真的写进去了。不核实的话，任何一步失败都会被下面那句
# 「✅ 已写进共识」掩盖过去，变成静默丢数据 —— 实跑中真发生过。
AFTER_BYTES=$(wc -c < "$CF" | tr -d ' ')
rm -f "$TMP"
t_unlock "组-$G"

if [ "$AFTER_BYTES" -le "$BEFORE_BYTES" ]; then
  echo "❌ 写入失败：共识文件大小没变（写前 ${BEFORE_BYTES} 字节，写后 ${AFTER_BYTES} 字节）" >&2
  echo "   你的内容没有保存。请把这条结论用 cctell 发到组里，别让它丢掉。" >&2
  exit 1
fi
# 取第一行的前 20 个「字」来核对。
# 不能用 head -c —— 那是按字节切，会把一个中文字劈成半个，
# grep 直接报 illegal byte sequence，好好的写入被误判成失败。
CHECK_LINE="$(printf '%s' "$BODY" | head -1)"
CHECK="${CHECK_LINE:0:20}"
if ! grep -qF "$CHECK" "$CF"; then
  echo "❌ 写入失败：文件里找不到刚写的内容。" >&2
  echo "   你的内容没有保存。请把这条结论用 cctell 发到组里，别让它丢掉。" >&2
  exit 1
fi

t_ok "已写进【${G}】的共识"

# ── 共识改了就提醒同步组外文档 ──
# 缺这一步实测出过事：共识在深挖里从 10 条涨到 30 条，而组外那份协作方案还停在 10 条那版，
# 就摆在需求包目录里，谁翻到都读到不全的 —— 而六道就绪门槛全在查共识本身，一次都没提醒过。
_SF="$(t_group_dir "$G")/状态.md"
if [ -f "$_SF" ]; then
  _OUT="$(awk '/^## 产出去向/{f=1;next} /^## /{f=0} f' "$_SF" | sed '/^[[:space:]]*$/d')"
  if [ -n "$_OUT" ] && ! printf '%s' "$_OUT" | grep -q '还没登记'; then
    echo
    echo "📌 共识变了 —— 下面这些组外的文档要跟着更新："
    printf '%s\n' "$_OUT" | sed 's/^/     /'
    echo "   （文档滞后就会有人照着旧的开工。改完顺手同步，别攒到最后。）"
  fi
fi

# ── 写进共识就必须通知全组 ──
# 共识是所有人共用的地基，改了地基不吭声，别人会在旧认知上继续干活。
# 通知失败不回滚共识（内容已经落盘了），但要明确报出来让会话自己补发。
NOTIFY_BODY="$(printf '【共识新增】以下内容已经人同意，写进本组共识，请据此对齐：\n\n%s\n\n补课看全文：cccatch "%s"' "$BODY" "$G")"
NOTIFY_OUT="$("$(dirname "${BASH_SOURCE[0]}")/cctell" "$G" --全组 \
     --目的 "共识改了：新增一条人已同意的约定，全员据此对齐（共识是共用地基，改了必须让所有人知道）" \
     "$NOTIFY_BODY" 2>&1)"
if [ $? -eq 0 ]; then
  echo "📣 已通知全组（共识变更必须让所有人知道）"
elif printf '%s' "$NOTIFY_OUT" | grep -q '暂无其他成员'; then
  echo "ℹ️  组里目前只有你一个人，没有可通知的对象。"
  echo "   等别人加入后，他们 ccjoin 时会自动补课看到这条共识。"
else
  echo "⚠️  共识写入成功，但【通知全组失败】。" >&2
  echo "   共识是共用地基，改了不吭声别人会在旧认知上继续干活。" >&2
  printf '   cctell 的报错：%s\n' "$(printf '%s' "$NOTIFY_OUT" | head -2)" >&2
  echo "   请手动补一条：cctell \"$G\" --全组 --目的 \"共识新增一条\" \"...\"" >&2
fi
echo
echo "───────── 当前共识全文 ─────────"
cat "$CF"
echo "────────────────────────────────"
echo
echo "⚠️  写完必须自己检查两件事，不然共识会烂掉："
echo
echo "  1. 【有没有重复】上面是不是已经有人写过同一条结论？"
echo "     多个端会各自把同一个共同结论 pin 一遍 —— 这是最常见的污染。"
echo "     发现重复就把多余的删掉，只留最完整的那条。"
echo
echo "  2. 【有没有矛盾】这条是不是改掉了上面某条旧约定？"
echo "     是的话直接编辑文件把旧的那条删掉：$CF"
echo "     共识里留两份互相矛盾的说法，比没写还糟 —— 后来的人不知道该信哪个。"
