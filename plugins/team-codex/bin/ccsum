#!/bin/bash
# ccsum —— 回捞：找出「说过但没进共识」的结论
#
#   ccsum <组名>
#
# 专治一种漏网：结论是在几条消息的来回中慢慢形成的，
# 没有哪一条单独说「就这么定了」，所以自动判定没命中，共识里还是旧的。
#
#   后端：wifi 字段必填 → iOS：拿不到 → 后端：那改成允许为空 → iOS：行
#
# 四条都在流水里，共识里却还写着「必填」。明天新人加入读共识，做错。
#
# 脚本只负责把素材摆出来（当前共识 + 全部流水）。
# 「哪条是漏掉的结论」需要判断，由会话来做 —— 脚本不会读也不会想。

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
t_ensure_skeleton

G="$1"
[ -n "$G" ] || t_die "用法：ccsum <组名>"
t_group_exists "$G" || t_die "没有这个组：$G"

echo "════════ 回捞素材：【${G}】 ════════"
echo
echo "──────── 一、当前共识（已经归档的约定）────────"
cat "$(t_group_consensus "$G")"
echo
echo "──────── 二、全部传话流水 ────────"
awk 'NR>4' "$(t_group_log "$G")"
echo
echo "──────── 三、会话请做这件事 ────────"
echo "逐条对比上面两份，找出【流水里达成了、但共识里没有或已过时】的结论。"
echo "重点找这几种："
echo "  · 来回讨论后改变了某个约定，但共识还是旧的"
echo "  · 某一端提出的限制（拿不到某字段、权限不同），别的端也该知道"
echo "  · 口头达成但没人正式写下来的决定"
echo
echo "找到之后：ccpin \"${G}\" \"<结论>\"    如果是修改旧约定，直接编辑共识文件把旧的改掉。"
echo "确认没有漏网的，就说一句「共识是全的」，不要为了交差硬凑。"
