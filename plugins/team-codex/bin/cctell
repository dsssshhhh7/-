#!/bin/bash
# cctell —— 给讨论组发消息
#
# 用法：
#   cctell <组名> "内容"                     发给全组（自己除外）
#   cctell <组名> --给 <代号> "内容"          只发给组内某一人
#   cctell <组名> --急 "内容"                 走快道，绕过加工员直送
#   cctell <组名> --深度 N "内容"             自动回复时用，N = 上一条的深度+1
#   cctell <组名> --文件 <路径>               从文件读内容
#
# ⚠️ 内容里有反引号、$ 或反斜杠时，务必用 --文件，别直接写在命令行上 ——
#    命令行会把它们当特殊语法解释掉，内容被吃空还照常发出去，收发双方都不知道。
#    实测踩过：用反引号包了字段名，那两处被当成命令执行，字段名没了。
#
# 防循环：接力深度到 3 就拒发，必须由人重新起头。
#   你手动发起 = 深度 0，对方自动回 = 深度 1，你这边再自动回 = 深度 2 …

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
t_ensure_skeleton
t_ensure_mydir

# 往返轮数的三级控制。
#
# 早先只有一个"到 3 就硬拦"，实测下来是个错误设计：
#   · 三端每次撞线都用"另起一条"绕过去了，等于没拦住任何东西
#   · 更糟的是它制造了错误 —— 有一次某端因为"再往返一轮就到上限"，
#     赶着把四件事塞进一条消息，在最简单的那件上跳过了核实，发出了错结论
#
# 根子在于用"往返几次"当浪费的信号，而往返次数跟浪费根本不是一回事：
# 有价值的讨论可以很多轮，客套两轮就该停。判断标准应该是"有没有新信息"，
# 那件事工具判断不了，只有会话自己知道。
#
# 所以改成：前两级只提醒不拦，把判断权交回给会话；真失控了才硬拦兜底。
WARN_DEPTH=3     # 提个醒，照常发
ALERT_DEPTH=6    # 明确警告 + 要求说明为什么还得继续，照常发
MAX_DEPTH=10     # 硬拦，必须人介入

ME="$(t_sid)"
G=""; BODY=""; TO_ALIAS=""; URGENT="否"; DEPTH=0
ALL_GROUP=0; NEED_DECISION="否"; PURPOSE=""

BODY_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --给|--to)         TO_ALIAS="$2"; shift 2 ;;
    --全组|--all)      ALL_GROUP=1; shift ;;
    --目的|--why)      PURPOSE="$2"; shift 2 ;;
    --需决策|--decision) NEED_DECISION="是"; shift ;;
    --急|--urgent)     URGENT="是"; shift ;;
    --深度|--depth)    DEPTH="$2"; shift 2 ;;
    --文件|--file)     BODY_FILE="$2"; shift 2 ;;
    -*)                t_die "不认识的参数：$1" ;;
    *)                 if [ -z "$G" ]; then G="$1"; else BODY="$1"; fi; shift ;;
  esac
done

# 从文件读内容：长消息、或内容里带反引号 $ \ 这类字符时必须用这个。
# 直接写在命令行上的话，那些字符会被命令行当成特殊语法解释掉 ——
# 实测踩过：内容里用反引号包了字段名，那两处被当成命令执行，字段名被吃空，
# 而消息照常发出去了，收件人看到的是残缺句子，发件人自己也不知道。
if [ -n "$BODY_FILE" ]; then
  [ -f "$BODY_FILE" ] || t_die "找不到这个文件：$BODY_FILE"
  BODY="$(cat "$BODY_FILE")"
  [ -n "$BODY" ] || t_die "文件是空的：$BODY_FILE"
fi

# ── 正文写在命令行上时，查一个「被命令行吃掉内容」的指纹 ──
#
# 这个坑今天三个会话各栽过一次，而且它有三层后果、一层比一层重：
#   ① 内容被静默删空 —— 消息照发、不失败，句子读起来还通顺
#   ② 内容被换成某个命令的执行结果 —— 收件方看到一句读得通但完全不对的话
#   ③ 最坏：反引号里的东西被真的执行。今天没发生，机制上完全可能。
#
# ⚠️ 工具端救不了：cctell 拿到参数时字符串**已经**残缺了，它无从知道原意。
#    所以这里不是校验，只是找一个残留指纹 —— 反引号那对被吃掉后，
#    「地址是 ⟨反引号⟩…⟨反引号⟩ 结束」会变成「地址是·(两个空格)·结束」。
#    连续两个半角空格在正常中文写作里很少出现，够当信号用。
#
# 根治只有一条：正文走 --文件。走了文件就不检查（下面这段只在没走文件时跑）。
if [ -z "$BODY_FILE" ] && printf '%s' "$BODY" | grep -q '  '; then
  echo "⚠️  正文里出现了连续两个空格 —— 有可能是反引号里的内容被命令行吃掉了。"
  echo "   命令行会把反引号当成「执行这段命令、拿结果替换它」，把 \$xx 当成变量替换。"
  echo "   被吃掉时**消息照常发出、不报错**，句子读起来还通顺，所以最难发现。"
  echo
  echo "   这几行有连续空格，自己核一眼是不是少了东西："
  printf '%s' "$BODY" | grep -n '  ' | head -3 | sed 's/^/     第 /'
  echo
  echo "   要是真被吃了：把正文写进一个文件，改用  cctell \"$G\" … --文件 <路径>"
  echo "   走文件的内容一个字符都不会被解释（实测反引号、\$、方括号、感叹号全保住）。"
  echo
fi

[ -n "$G" ]    || t_die "用法：cctell <组名> \"内容\"    （跑 ccgroups 看有哪些组）"
[ -n "$BODY" ] || t_die "消息内容不能为空"
t_group_exists "$G" || t_die "没有这个组：$G"

MY_ALIAS="$(t_alias_of "$ME")"
[ -n "$MY_ALIAS" ] || t_die "你还没有代号。起一个：ccname <代号>（不用先进组）；要发消息还得先 ccjoin \"$G\" 进这个组"
t_is_member "$G" "$ME" || t_die "你不在【${G}】里，不能往这个组发消息。先 ccjoin \"$G\""

# ── 往返轮数：三级控制 ──
if [ "$DEPTH" -ge "$MAX_DEPTH" ]; then
  echo "🛑 拒绝发送：本话题已自动往返 ${DEPTH} 轮，到硬上限了。"
  echo
  echo "到这一步说明讨论已经失控 —— 要么在原地打转，要么卡在一个没有人拍板就推不动的地方。"
  echo "接下来必须人介入：把结论拍板，或者由人重新起一个话题。"
  echo
  echo "（如果你确信还有实质内容要说，把它写进自己目录下的文档，等人来看，别绕过这个限制。）"
  exit 3
fi

if [ "$DEPTH" -ge "$ALERT_DEPTH" ]; then
  echo "⚠️  已经往返 ${DEPTH} 轮了（硬上限 ${MAX_DEPTH}）。这条照常发出，但请当场自问："
  echo "     · 这一轮带来了新信息吗？还是在确认、附和、复述对方说过的话？"
  echo "     · 还没定下来的那部分，是技术问题，还是其实在等人拍板？"
  echo "   是后者的话，停下来把它列成待拍板事项，比再聊五轮有用。"
  echo
elif [ "$DEPTH" -ge "$WARN_DEPTH" ]; then
  echo "ℹ️  这是第 ${DEPTH} 轮往返。照常发出，注意收敛 —— 纯确认和附和不用回。"
  echo
fi

# ── 必须显式指定发给谁：单发 --给，群发 --全组 ──
#
# 早先不带参数默认就是群发，实测下来那是个错误默认：一个 4 人组 56 条消息里
# 41 条群发（73%），产生 123 次唤醒，其中一个成员堆了 25 条未读，每条都在回
# 「这条没有我的待办」。发送方图省事一次，代价落在另外三个人身上三次。
# 现在把它变成绕不过去的一步——想省事也省不掉。
if [ -z "$TO_ALIAS" ] && [ "$ALL_GROUP" -eq 0 ]; then
  echo "❌ 必须说清楚这条发给谁。" >&2
  echo >&2
  echo "   单发（推荐）：cctell \"${G}\" --给 <代号> \"内容\"" >&2
  echo "   确实全组都要看：cctell \"${G}\" --全组 \"内容\"" >&2
  echo >&2
  echo "   本组现有成员：" >&2
  while IFS= read -r m; do
    [ -z "$m" ] || [ "$m" = "$ME" ] && continue
    printf '     %s %s\n' "$(t_pad "$(t_display "$m")" 16)" "$(t_member_role "$G" "$m")" >&2
  done <<< "$(t_members_of "$G")"
  echo >&2
  echo "   先问自己一句：这条是要谁办事？" >&2
  echo "   只有一两个人要办就单发。「我不确定谁需要所以发给所有人」不是稳妥，" >&2
  echo "   是把判断成本从你一个人身上，转嫁到了另外几个人身上。" >&2
  exit 2
fi

# ── 必须说明目的：为什么发给他 ──
#
# 只说"发给谁"还不够 —— 收件方拿到消息第一件事是判断"这跟我什么关系"，
# 而那个判断发送方本来就做过一遍。不写下来，等于让每个收件人再做一次。
# 群发时要求逐个说明，是因为对不同的人目的往往不一样，一句笼统的说明等于没说。
if [ -z "$PURPOSE" ]; then
  echo "❌ 还要说清楚：为什么发给他（--目的）。" >&2
  echo >&2
  if [ "$ALL_GROUP" -eq 1 ]; then
    echo "   群发时要逐个写明，格式：" >&2
    echo "     --目的 \"发给 安卓：确认扫描口径；发给 iOS：这条影响你的降级分支\"" >&2
    echo >&2
    echo "   本组现有成员，逐个想一遍你为什么要发给他：" >&2
    while IFS= read -r m; do
      [ -z "$m" ] || [ "$m" = "$ME" ] && continue
      printf '     %s %s\n' "$(t_pad "$(t_display "$m")" 16)" "$(t_member_role "$G" "$m")" >&2
    done <<< "$(t_members_of "$G")"
    echo >&2
    echo "   要是有人你写不出目的 —— 那就别发给他，改成单发。" >&2
  else
    echo "   单发时写一句就行，格式：" >&2
    echo "     --目的 \"确认扫描口径，这条影响你那边的实现方式\"" >&2
  fi
  echo >&2
  echo "   目的会跟着消息一起送到，收件方第一眼就知道这跟他什么关系，" >&2
  echo "   不用自己从正文里猜。这一步你做一次，省下的是每个收件人各做一次。" >&2
  exit 2
fi

# ── 群发时，目的里点名少于 2 个人 → 提醒（只提醒，不拦） ──
#
# 「必须写目的」那道门已经 100% 生效：实测一个 5 人组跑了一整天，
# 人自己写的 214 条消息，0 条漏写。
#
# 但「群发要逐个写」这条基本没执行 —— 同一批数据里 57 条群发：
#   · 逐个人写的      10 条（17%）
#   · 只点了一个人    26 条（45%）  ← 这些本该单发
#   · 一句笼统没点名  21 条（36%）
#
# 中间那 45% 是最该提醒的：目的里只写得出一个人，**本身就证明只有那一个人要办**。
# 守则里「有哪个人你写不出目的，就说明不该发给他」，反过来同样成立。
#
# 为什么只提醒不拦：确实存在「一条通知给所有人」的正当群发（叫停、口径变更），
# 那种笼统写法是对的。脚本分不出这两种，交给人判断。
if [ "$ALL_GROUP" -eq 1 ]; then
  _OTHERS=0
  while IFS= read -r m; do
    [ -z "$m" ] || [ "$m" = "$ME" ] && continue
    _OTHERS=$((_OTHERS+1))
  done <<< "$(t_members_of "$G")"
  _NAMED=$(printf '%s' "$PURPOSE" | grep -o '发给' | wc -l | tr -d ' ')
  # 组里只有一个别人时，群发就等于单发，不提醒
  if [ "$_OTHERS" -ge 2 ] && [ "$_NAMED" -lt 2 ]; then
    if [ "$_NAMED" -eq 1 ]; then
      echo "⚠️  你群发了，但目的里只点了一个人 —— 这多半该是单发。"
      echo "   只写得出一个人的目的，本身就说明只有那一个人要办。"
      echo "   群发一次，另外 $((_OTHERS-1)) 个窗口都要被叫醒、读一遍、再各自判断「跟我没关系」。"
      echo "   改法：cctell \"$G\" --给 <那个人> --目的 \"…\" \"内容\""
    else
      echo "⚠️  你群发了，但目的里一个人都没点名。"
      echo "   群发的目的要逐个写：--目的 \"发给 甲：…；发给 乙：…\""
      echo "   对不同的人目的往往不一样，一句笼统的说明等于没说。"
    fi
    echo "   （确实是给全组的通知就不用管这条 —— 叫停、口径变更那种，笼统写是对的。）"
    echo
  fi
fi

# ── 内容佐证检查：结论要带得出证据 ──
#
# 基准要求是「内容 + 内容佐证」。工具判断不了佐证够不够，但能看出
# 这条里有没有【任何】佐证痕迹——一点都没有的话当场提醒。
# 短消息（协调、确认这类）不检查，那些本来就不需要佐证。
if [ ${#BODY} -gt 50 ]; then
  HAS_EVIDENCE=0
  # 文件行号：Foo.java:123 这种
  printf '%s' "$BODY" | grep -qE '[A-Za-z0-9_/.-]+\.(java|m|h|mm|php|js|ts|jsx|tsx|py|kt|swift|xml|sql|json|yaml|yml|sh|md|gradle):[0-9]+' && HAS_EVIDENCE=1
  # 亲自核实过的动作
  printf '%s' "$BODY" | grep -qE '实测|复核|核实|验证|查了|读了|跑了|执行了|打开了|grep|搜了|真机' && HAS_EVIDENCE=1
  # 引用他人，标了出处
  printf '%s' "$BODY" | grep -qE '据.{1,12}(说|讲|提|给)|引用|采信|依据|来自|出处' && HAS_EVIDENCE=1
  # 老实标注不确定
  printf '%s' "$BODY" | grep -qE '推测|待验证|没实测|未核实|不确定|存疑|我猜' && HAS_EVIDENCE=1
  # 直接贴命令回显 —— 这是最硬的一类证据，先前反而认不出来
  # （实跑中连着误报三次：贴了两边 md5、贴了退出码和字节数，照样说「找不到佐证」）
  printf '%s' "$BODY" | grep -qE '[0-9a-f]{16,}|退出码|真实回显|真实输出|命令输出|逐字贴|未加工' && HAS_EVIDENCE=1
  # 逐字引共识/需求原文 —— 引的是白纸黑字，也是出处
  printf '%s' "$BODY" | grep -qE '共识里|共识「|原话|原文写着|需求原文' && HAS_EVIDENCE=1

  if [ "$HAS_EVIDENCE" -eq 0 ]; then
    echo "⚠️  这条里找不到任何佐证痕迹（没有文件行号、没有核实动作、没有出处、也没标注不确定）。"
    echo "   基准要求是【内容 + 内容佐证】——别人会把你的结论当事实拿去用。"
    echo "   三类至少占一样："
    echo "     · 我亲自核实的 → 带上 文件:行号 或命令输出"
    echo "     · 引用别人的   → 写明出处（据 XX 说 / 采信 XX 的结论）"
    echo "     · 我推测的     → 明确标出来（推测 / 待验证 / 没实测过）"
    echo "   纯协调、纯确认的短消息不受此限，这条超过 50 字所以提醒你一下。"
    echo
  fi
fi

# ── 这条是不是在「定事情」：定了就得是人定的，而且得进共识 ──
#
# 两条规矩，缺一条这套东西就白搭：
#   ① 该由人拍板的，会话不许自己定 —— 包括「我看用 A 吧」这种把选择顺手做掉的说法。
#      会话之间互相踢决策球是最容易空转的一种（A 问 B 选哪个，B 说你定，绕三圈没人有权定）。
#   ② 人拍板过的结论，必须进共识 —— 共识的规矩一直是单向的：
#      只防「写进不该写的」，从不防「该写的没写」。
#      而漏写的后果正好是这套东西存在的理由：中途加入的人读那一份追不上进度。
#
# 判断这条是不是决策，脚本做不了（跟佐证检查一样）。能做的是认出**决策的口气**，
# 然后把两条规矩摆到眼前 —— 提醒不拦截，因为误判的代价（挡住正常协作）比漏判大。
if printf '%s' "$BODY" | grep -qE '就这么定|就定|我看用|那就用|就用|决定用|改成用|最终采用|方案[[:space:]]*[ABC甲乙]|二选一|要不要|哪个更|还是用|选哪|你定|我定'; then
  _DEC_OK=0
  # 明说了「去问人 / 人已经拍过」的，就是按规矩在走，不再啰嗦
  printf '%s' "$BODY" | grep -qE '人拍板|人已定|人说了|问过人|人点头|待人拍板|我去问人|请人定|等人定' && _DEC_OK=1
  [ "$NEED_DECISION" = "是" ] && _DEC_OK=1
  # 说了「人拍板了」的，不再免检 —— 反过来追一句。
  #
  # 这道提醒是靠正文措辞触发的，而让它闭嘴的那句话正好就是「人拍板了」：
  # 任何会话只要写上这四个字就能让它不出现，是不是真问过人，脚本无从判断。
  # （真机验收中由测试2 窗口指出，它同时点明：这道提醒的定位只能是
  #  「提醒忘了的人」，不能被当成「防住编的人」。）
  # 所以措辞免检改成措辞追问：你说人定了，那这条现在就该在共识里，写了吗。
  if [ "$_DEC_OK" -eq 1 ] && printf '%s' "$BODY" | grep -qE '人拍板|人已定|人说了|人点头|请人定'; then
    echo "📌 你说这条人已经定了 —— 那它现在就该在共识里。写了吗？"
    echo "   写了：忽略这句。没写：ccpin \"$G\" \"<人定的那句>\" --节 <哪一节> --核对 已"
    echo "   ⚠️ 「人同意这个结论」不等于「人逐字看过这段话」。--核对 已 说的是后者 ——"
    echo "      你把人拍板的要点自己组织成一段话，那段话人没看过，就不能标已核对。"
    echo
  fi
  if [ "$_DEC_OK" -eq 0 ]; then
    echo "⚠️  这条读着像在【定事情】，但没看出人参与过。两条规矩摆在这儿："
    echo "   ① **该由人定的，你不许自己定** —— 包括「我看用 A 吧」这种顺手把选择做掉。"
    echo "      要对方拍板：加 --需决策（而且发之前你自己先问过人）。"
    echo "      该问人的先去问：ccstatus \"$G\" --认领 \"<这件待人拍板的事>\"，问完 --已问 … --写进 <共识哪一节>"
    echo "   ② **人拍板过的结论，必须进共识** —— 只发消息不 pin，等于没定："
    echo "      别人补课时读不到，中途进来的人更不知道。"
    echo "      ccpin \"$G\" \"<人定的那句>\" --节 <哪一节> --核对 已"
    echo "   （只是转述、讨论、举例的话，不用理这条。）"
    echo
  fi
fi

# ── 确定收件人 ──
RECIPIENTS=""
if [ -n "$TO_ALIAS" ]; then
  TO_ID="$(t_id_of "$TO_ALIAS")"
  [ -n "$TO_ID" ] || {
    echo "❌ 找不到代号【${TO_ALIAS}】。本组现有成员："
    t_members_of "$G" | while IFS= read -r m; do [ -n "$m" ] && echo "    $(t_display "$m")"; done
    exit 1
  }
  t_is_member "$G" "$TO_ID" || {
    echo "❌ 【${TO_ALIAS}】不在【${G}】里（可能已退出）。本组现有成员："
    t_members_of "$G" | while IFS= read -r m; do [ -n "$m" ] && echo "    $(t_display "$m")"; done
    exit 1
  }
  RECIPIENTS="$TO_ID"
  TO_LABEL="$TO_ALIAS"
else
  RECIPIENTS="$(t_members_of "$G" | grep -vxF "$ME")"
  TO_LABEL="全组"
fi

if [ -z "$RECIPIENTS" ]; then
  echo "⚠️  本组暂无其他成员，消息无人接收。"
  echo "    先把别的会话拉进来：去它们的窗口敲 ccjoin \"$G\" --代号 <代号>"
  exit 1
fi

# ── 投递 ──
MID="$(t_msgid)"
SENT_DIR="$(t_mydir)/.sent"; mkdir -p "$SENT_DIR"

echo
if [ "${TEAM_RUNTIME}" = "codex" ]; then
  echo "📝 已写入共享账本（尚未调用 Codex 原生任务消息）："
elif [ "$NEED_DECISION" = "是" ]; then
  echo "🔖 已发出（标记为【需决策】——收件方会知道这条要拍板）："
elif [ "$URGENT" = "是" ]; then
  echo "🚨 已发出（紧急，走快道）："
else
  echo "📤 已发出："
fi
echo

ackinit=""
count=0
while IFS= read -r rid; do
  [ -z "$rid" ] && continue
  t_deliver "$rid" "$G" "$MY_ALIAS" "$ME" "$BODY" "$DEPTH" "$URGENT" 普通 "$MID" "$NEED_DECISION" "$PURPOSE" >/dev/null
  name="$(t_display "$rid")"
  if [ "${TEAM_RUNTIME}" = "codex" ]; then
    st="待原生发送"
    hint="team Skill 发送成功后才算送达"
  else
    st="$(t_status_of "$rid")"
    case "$st" in
      在线空闲) hint="预计 15 秒内处理" ;;
      在线忙碌) hint="在忙，会排队" ;;
      等人回话) hint="⚠️ 卡在等人回话，你去那个窗口点一下它才会往下走" ;;
      已关闭)   hint="消息已存入信箱，等它下次开起来" ;;
      *)        hint="在线，会处理" ;;
    esac
  fi
  printf '  %s %s %s\n' "$(t_pad "$name" 16)" "$(t_pad "$st" 10)" "$hint"
  ackinit="${ackinit:+$ackinit }${name}··"
  count=$((count + 1))
done <<< "$RECIPIENTS"

# 记下我发出的，收件程序靠这个做超时提醒
cat > "$SENT_DIR/$MID" <<EOF
组=$G
时间戳=$(t_epoch)
收件人=$(printf '%s' "$RECIPIENTS" | tr '\n' ',')
已提醒=否
EOF

# ── 写传话记录 ──
LOG_BODY="[目的] ${PURPOSE} ｜ ${BODY}"
[ "$NEED_DECISION" = "是" ] && LOG_BODY="【需决策】${LOG_BODY}"
t_lock "组-$G" && {
  t_log_append "$G" "$MID" "$MY_ALIAS" "$TO_LABEL" "$LOG_BODY" "$ackinit"
  # 全文另存一份 —— 收件人处理完会删掉信箱里那份，删了之后这里是唯一的完整副本
  t_log_full "$G" "$MID" "$MY_ALIAS" "$TO_LABEL" "$PURPOSE" "$BODY"
  t_unlock "组-$G"
}

echo
echo "消息号 $MID ｜ 往返第 $DEPTH 轮 ｜ 共 $count 人"

# 群发给三个人以上时提醒一句。不阻止 —— 有些消息确实该全组看。
# 但代价要说清楚：每个收件人都会被唤醒、都要读一遍、都要判断"跟我有没有关系"，
# 而这些都是真实开销。实测有个组 73% 的消息是群发，其中一个成员堆了 25 条未读，
# 每条都得回一句"这条没有我的待办"。
if [ "$NEED_DECISION" = "是" ]; then
  echo
  echo "🔖 这条标了【需决策】。守则要求：**发这类消息之前必须先问过人**。"
  echo "   如果你还没问，现在去问 —— 这个标记记进了消息头和传话记录，事后查得出来。"
fi
[ "$DEPTH" -eq $((MAX_DEPTH - 1)) ] && echo "⚠️  下一轮就到硬上限了。"
echo
echo "查回执：ccack \"$G\""
