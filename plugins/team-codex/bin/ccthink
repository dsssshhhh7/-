#!/bin/bash
# ccthink —— 进「就绪」之前的深度思考扫描
#
#   ccthink <组名>                          看进度：哪些维度扫过了、还剩哪些
#   ccthink <组名> --扫 <维度> --发现 "..."   声明扫过某个维度、结果是什么
#   ccthink <组名> --自查 "..."              最后一轮自查：哪个角度没起头、哪个结论没验证
#   ccthink <组名> --人喊停 ["原因"]          人说够了，提前收尾
#   ccthink <组名> --维度                    只列出维度清单
#
# 这东西要解决什么：
#   会话写共识时的默认动作是【从会话里提取已经聊过的东西】——被动的。
#   会话里没人提过的，一条都不会进共识，哪怕它明摆着该定。
#
#   实跑中的例子：一个跨端需求的共识写了 10 条，看着挺全，但
#   「新消息类型字符串定成什么」（整条链路的第一颗扣子）、
#   「推送里带哪些内容」（端上本地存、不回查，缺了就永远显示不出来，
#    而且已发出的消息补不回来）——这两条谁都没提，因为会话里正好没聊到。
#
#   所以这一步是【主动挖】：拿着一张维度清单，一个角度一个角度地问
#   「这里有没有该定而没定的」，挖出来的逐条问人，人拍了才进共识。
#
# ⚠️ 一个实测踩过的漏：**评审意见是独立于需求正文的一份材料**，必须单独逐条对。
#   实跑中会话声称「需求原文逐段过」扫完了，实际只过了正文和澄清表，
#   评审讨论那几条没当清单核 —— 结果漏掉两条产品明确答过的结论，
#   其中一条会让用户收到「你评论了你自己的拜访」这种荒谬提醒。
#   评审记录记的正是「需求文档没写清、评审时才补上的结论」，最容易漏、也最该进共识。
#
# 规矩（脚本管不了，但写在这儿）：
#   · 每提一条必须附【不定会怎样】—— 写不出后果的，说明这条不该占用人的注意力
#   · 挖出来的点按后果严重度排序，一次给人 3-4 条，不许打包问「这些都行吗」
#   · 人没表态的一律不写进共识
#
# 生命周期：这一步过不了，组就推不到「就绪」，各端进不来。

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
t_ensure_skeleton

# ── 维度清单 ──
# 前两个是「拿需求原文逐段对照」，最容易漏、也最值钱：
# 需求里白纸黑字写了、但没进共识的东西，各端实现时各按各的理解做。
DIMS=(
  "需求原文逐段过|一段一段读需求正文，每段问：这里有没有各端会做不一致的东西"
  "评审意见逐条过|评审/答疑记录是独立材料，一条条对：产品答过的结论有没有全进共识"
  "需求本身的毛病|写错的、含糊的、自相矛盾的、跟代码现状不符的"
  "数据|存哪儿、谁是真相源、要不要留痕、能不能改能不能删"
  "边界值与上限|多长、多少个、超了什么表现"
  "失败与异常|哪一步会失败、失败是静默的还是报错的、失败后怎么办"
  "权限|谁能看、谁能操作、权限中途变了怎么办"
  "状态变化|开关关了、记录删了、人离职了、版本没升级"
  "端间交接物|谁给谁什么、格式谁定、定错了什么表现"
  "兼容与撞车|老数据、老版本、会不会撞上已上线的功能"
  "并发与时序|重复到达、乱序、两个人同时操作"
  "验收口径|哪些「设计如此不是缺陷」的取舍要提前跟测试交底"
)

G="$1"; shift 2>/dev/null
[ -n "$G" ] || t_die "用法：ccthink <组名> [--扫 <维度> --发现 \"...\" | --自查 \"...\" | --人喊停 | --维度]"

# --维度 不需要组存在也能看
if [ "$1" = "--维度" ] || [ "$1" = "--dims" ]; then
  echo "深度思考的 ${#DIMS[@]} 个维度："; echo
  i=1
  for d in "${DIMS[@]}"; do
    printf '  %2d. %s %s\n' "$i" "$(t_pad "${d%%|*}" 16)" "${d#*|}"; i=$((i+1))
  done
  exit 0
fi

t_group_exists "$G" || t_die "没有这个组：$G"
ME="$(t_sid)"
t_is_member "$G" "$ME" || t_die "你不在【${G}】里"
ALIAS="$(t_alias_of "$ME")"
TF="$(t_group_dir "$G")/深度思考.md"

if [ ! -f "$TF" ]; then
  {
    printf '# 深度思考扫描 · %s\n\n' "$G"
    printf '> 进「就绪」之前，下面每个维度都要扫一遍并声明结果。\n'
    printf '> 目的是**主动挖出「该定而没定」的点**去问人，而不是只记录会话里已经聊过的东西。\n'
    printf '> 每提一条必须附「不定会怎样」；挖出来的点按后果严重度排序，一次问人 3-4 条。\n\n'
    printf '## 已扫维度\n\n'
    printf '## 最后自查\n\n（还没做）\n\n'
    printf '## 收尾\n\n（还没收尾）\n'
  } > "$TF"
fi

# ── 开扫之前：素材必须已登记 ──
# 头两个维度就是「拿需求原文逐段过」。手里没有原文，那两个维度没法扫、只能凭空编。
# 新开的会话尤其危险：它可能压根没读过任何东西就来建组、来深挖了。
SF="$(t_group_dir "$G")/状态.md"
t_material_ok() {
  [ -f "$SF" ] || return 1
  local M; M="$(awk '/^## 素材来源/{f=1;next} /^## /{f=0} f' "$SF" | sed '/^[[:space:]]*$/d')"
  [ -n "$M" ] && ! printf '%s' "$M" | grep -q '还没登记'
}
t_need_material() {
  t_material_ok && return 0
  echo "❌ 还不能深挖：这个组的【素材来源】还没登记。" >&2
  echo >&2
  echo "   这个组要处理的东西是什么？原始材料在哪？" >&2
  echo "   ——需求文档路径、链接，或者人口述的描述原文，都行，但**必须有**。" >&2
  echo >&2
  echo "   为什么卡在这儿：深挖的头两个维度是「需求原文逐段过」和「需求本身的毛病」。" >&2
  echo "   手里没有原文，这两个维度根本没法扫，扫出来的只能是编的。" >&2
  echo "   **如果你这个会话还没读过任何需求或描述，现在就去问人要，别硬扫。**" >&2
  echo >&2
  echo "   拿到之后：ccstatus \"$G\" --素材 \"...\"" >&2
  exit 1
}

t_scanned() { grep -c "^### \[$1\]" "$TF" 2>/dev/null | tr -d ' '; }
t_selfcheck_done() { sed -n '/^## 最后自查/,/^## 收尾/p' "$TF" | grep -qv '还没做' && sed -n '/^## 最后自查/,/^## 收尾/p' "$TF" | grep -q '[^[:space:]#（）]' && ! sed -n '/^## 最后自查/,/^## 收尾/p' "$TF" | grep -q '（还没做）'; }
t_stopped() { ! grep -q '（还没收尾）' "$TF"; }

case "$1" in
  --扫|--scan)
    DIM="$2"; FOUND=""
    shift 2 2>/dev/null
    while [ $# -gt 0 ]; do
      case "$1" in --发现|--found) FOUND="$2"; shift 2 ;; *) shift ;; esac
    done
    t_need_material
    [ -n "$DIM" ] || t_die "用法：ccthink \"$G\" --扫 <维度> --发现 \"扫出了什么\""
    # 维度名必须在清单里
    HIT=0; for d in "${DIMS[@]}"; do [ "${d%%|*}" = "$DIM" ] && HIT=1; done
    if [ "$HIT" != 1 ]; then
      echo "❌ 不认识的维度：$DIM" >&2; echo >&2
      echo "   可用的维度（跑 ccthink \"$G\" --维度 看详细说明）：" >&2
      for d in "${DIMS[@]}"; do echo "     · ${d%%|*}" >&2; done
      exit 1
    fi
    if [ -z "$FOUND" ]; then
      echo "❌ 还差一样：这个维度扫出了什么？加 --发现 \"...\"" >&2; echo >&2
      echo "   没挖到东西也要写，写「没找到，因为……」——" >&2
      echo "   空着等于没扫，而这一步的全部价值就在于**扫过了、并且说得出扫的结果**。" >&2
      echo >&2
      echo "   ⚠️ 挖出来的每条都要附【不定会怎样】。写不出后果的那条，说明它不该占用人的注意力。" >&2
      exit 1
    fi
    t_lock "组-$G" || t_die "该组文件被占用"
    HEAD_LINE="$(grep -n '^## 最后自查' "$TF" | head -1 | cut -d: -f1)"
    TMP="$TF.tmp.$$"
    head -n "$((HEAD_LINE - 1))" "$TF" > "$TMP"
    printf '### [%s] · %s · %s\n\n%s\n\n' "$DIM" "$(t_now)" "$ALIAS" "$FOUND" >> "$TMP"
    tail -n "+$HEAD_LINE" "$TF" >> "$TMP"
    mv "$TMP" "$TF"
    t_unlock "组-$G"
    grep -q "^### \[$DIM\]" "$TF" || t_die "没写进去，请重试"
    t_ok "已记下【${DIM}】的扫描结果"
    ;;

  --自查|--selfcheck)
    BODY="$2"
    [ -n "$BODY" ] || t_die "用法：ccthink \"$G\" --自查 \"哪个角度根本没起头、哪个结论没验证\""
    t_lock "组-$G" || t_die "该组文件被占用"
    A="$(grep -n '^## 最后自查' "$TF" | head -1 | cut -d: -f1)"
    B="$(grep -n '^## 收尾' "$TF" | head -1 | cut -d: -f1)"
    TMP="$TF.tmp.$$"
    head -n "$A" "$TF" > "$TMP"
    printf '\n%s\n\n> 由 %s 于 %s\n\n' "$BODY" "$ALIAS" "$(t_now)" >> "$TMP"
    tail -n "+$B" "$TF" >> "$TMP"
    mv "$TMP" "$TF"
    t_unlock "组-$G"
    t_ok "自查已记下"
    ;;

  --人喊停|--stop)
    WHY="${2:-人说够了}"
    t_lock "组-$G" || t_die "该组文件被占用"
    TMP="$TF.tmp.$$"
    sed "s/^（还没收尾）$/- ${WHY}（${ALIAS} 记于 $(t_now)）/" "$TF" > "$TMP" && mv "$TMP" "$TF"
    t_unlock "组-$G"
    t_ok "已记：人喊停"
    echo "   没扫完的维度不再拦就绪，但它们会留在记录里，谁都看得见还剩哪些没挖。"
    ;;

  --检查|--check)
    # 供 ccstatus --就绪 调用。通过返回 0；没走完返回 1 并说明还缺什么。
    if ! t_material_ok; then
      echo "   素材来源还没登记 —— 这个组要处理的东西是什么、原始材料在哪，得先有。" >&2
      echo "   （深挖头两个维度是「需求原文逐段过」，没原文扫不了。）" >&2
      exit 1
    fi
    if t_stopped; then exit 0; fi
    MISS=()
    for d in "${DIMS[@]}"; do
      NAME="${d%%|*}"
      [ "$(t_scanned "$NAME")" -gt 0 ] || MISS+=("$NAME")
    done
    SC_OK=1; t_selfcheck_done || SC_OK=0
    if [ "${#MISS[@]}" -eq 0 ] && [ "$SC_OK" = 1 ]; then exit 0; fi
    echo "   深度思考还没走完：" >&2
    if [ "${#MISS[@]}" -gt 0 ]; then
      echo "     · 还有 ${#MISS[@]} 个维度没扫：" >&2
      for m in "${MISS[@]}"; do echo "         － $m" >&2; done
    fi
    [ "$SC_OK" = 1 ] || echo "     · 最后一轮自查还没做（ccthink \"$G\" --自查 \"...\"）" >&2
    echo >&2
    echo "   这一步是【主动挖该定而没定的点】，不是记录会话里聊过的东西。" >&2
    echo "   挖到的按后果严重度排序、一次问人 3-4 条，人拍了的用 ccpin 写进共识。" >&2
    echo "   跑 ccthink \"$G\" 看该从哪个维度下手。" >&2
    echo "   ⚠️ 跟人说这件事时用 /team 的形式：让他看进度说「/team think」，他觉得够了说「/team think 停」；" >&2
    echo "      别让人去敲 ccthink —— 底层命令是你执行的。" >&2
    exit 1
    ;;

  "")
    echo "【${G}】深度思考扫描进度"; echo
    t_material_ok || { echo "  ❌ 素材来源还没登记 —— 先跑 ccstatus \"$G\" --素材 \"...\"，否则没法开扫（跟人说：「/team material ...」）"; echo; }
    DONE=0
    for d in "${DIMS[@]}"; do
      NAME="${d%%|*}"
      if [ "$(t_scanned "$NAME")" -gt 0 ]; then
        printf '  ✅ %s\n' "$NAME"; DONE=$((DONE+1))
      else
        printf '  ⏳ %s %s\n' "$(t_pad "$NAME" 16)" "${d#*|}"
      fi
    done
    echo
    echo "  已扫 ${DONE}/${#DIMS[@]} 个维度"
    t_selfcheck_done && echo "  ✅ 最后自查：已做" || echo "  ⏳ 最后自查：还没做"
    t_stopped && echo "  🛑 人已喊停（没扫完的不再拦就绪）"
    echo
    if [ "$DONE" -lt "${#DIMS[@]}" ] && ! t_stopped; then
      echo "  下一步：挑一个还没扫的维度，从需求和代码里挖「该定而没定」的点，"
      echo "         挖到的按后果严重度排序、一次问人 3-4 条，人拍了的用 ccpin 写进共识，"
      echo "         然后 ccthink \"$G\" --扫 <维度> --发现 \"扫出了什么\""
      echo
      echo "  ⚠️ 每条必须附【不定会怎样】。写不出后果的，别拿去占用人的注意力。"
    fi
    exit 0
    ;;

  *)
    t_die "不认识的参数：$1（可用：--扫 / --发现 / --自查 / --人喊停 / --维度 / --检查）"
    ;;
esac
