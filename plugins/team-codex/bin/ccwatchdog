#!/bin/bash
# ccwatchdog —— 给 hook 用的检测脚本：收件程序该在却不在时，提醒会话起它
#
#   ccwatchdog          静默检测，只在【真有活没人干】时输出一行
#   ccwatchdog --说明   不管有没有事都把判断依据打出来（排查用）
#
# 为什么需要它：
#   收件程序必须由会话通过盯梢工具启动 —— 它要把消息推进对话流，
#   而 hook 是外部跑的命令，它启动的进程输出没地方去，只会多一个孤儿进程。
#   所以 hook 不能"自己起"，只能"发现问题并提醒会话去起"。
#
# 判定标准是【这个会话是不是该有一个在听】，不是【现在有没有消息】：
#
#   不在任何讨论组      → 静默（本来就不该有收件程序）
#   在组 + 程序在跑      → 静默（一切正常）
#   在组 + 程序不在      → ⚠️ 出声，**不管信箱是空是满**
#
# ⚠️ 最后一条以前是「信箱有未读 + 程序不在 → 才出声」，理由是「没消息等着就不必催，省资源」。
#    **那个理由把场景弄反了**：恢复一个会话时信箱通常是空的 → 静默 → 收件程序不起 →
#    之后进来的消息推不进对话流，而本钩子只在【会话启动】和【人敲字】两个时机跑，
#    **于是那个会话一直是聋的，直到有人去它窗口敲一个字**。详见下面第 4 节的完整经过。

source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

VERBOSE=0
[ "$1" = "--说明" ] || [ "$1" = "--verbose" ] && VERBOSE=1

# 骨架都还没建过 → 这台机器压根没用过协作，直接静默退出，别去建目录
[ -d "$TEAM_ROOT" ] || { [ "$VERBOSE" = 1 ] && echo "还没用过协作（$TEAM_ROOT 不存在）"; exit 0; }

ME="$(t_sid)"
[ -n "$ME" ] || { [ "$VERBOSE" = 1 ] && echo "拿不到会话编号"; exit 0; }

MYDIR="$SESSIONS_DIR/$ME"
INBOX="$MYDIR/收件箱"
PIDFILE="$MYDIR/.watcher.pid"

# ── 1. 我在协作里吗 ──
#
# ⚠️ 这里【不查会话索引】，直接扫各组的成员表。
#    原因：成员表才是真相，索引只是给人看的缓存，两者会脱节 ——
#    实测遇到过「组目录被删了但索引还记着我在里面」，也遇到过索引查询
#    返回莫名其妙的值。判断"我在不在组里"这种要害事，只认成员表。
MYGROUPS=""
for gd in "$GROUPS_DIR"/*/; do
  [ -d "$gd" ] || continue
  mf="${gd}成员.md"
  [ -f "$mf" ] || continue
  if grep -q "^| *${ME} *|" "$mf" 2>/dev/null; then
    gname="$(basename "$gd")"
    MYGROUPS="${MYGROUPS:+${MYGROUPS}、}${gname}"
  fi
done

# 有代号 = 接入了传话台 = 随时可能有人传话给你 → 也需要收件程序在岗。
# ⚠️ 判据从「在不在组里」扩成「在组里 **或** 有代号」：
#    传话台不是组、没有成员表，只能从索引里看代号。
#    上面那段坚持只认成员表，是因为「我在不在这个组里」有成员表这个真相可查；
#    而「我有没有代号」索引本来就是唯一的记录处，没有第二份可对。
MYALIAS="$(t_alias_of "$ME" 2>/dev/null)"

if [ -z "$MYGROUPS" ] && [ -z "$MYALIAS" ]; then
  [ "$VERBOSE" = 1 ] && echo "没有代号、也不在任何讨论组 → 不需要收件程序"
  exit 0
fi

# ── 2. 信箱里有几条没处理的 ──
N=$(find "$INBOX" -maxdepth 1 -name '*.md' -type f 2>/dev/null | wc -l | tr -d ' ')

# ── 3. 收件程序还活着吗 ──
ALIVE=0
if [ -f "$PIDFILE" ]; then
  P="$(cat "$PIDFILE" 2>/dev/null)"
  [ -n "$P" ] && kill -0 "$P" 2>/dev/null && ALIVE=1
fi

if [ "$VERBOSE" = 1 ]; then
  echo "在组：$MYGROUPS"
  echo "未读：$N 条"
  echo "收件程序：$([ "$ALIVE" = 1 ] && echo "在岗（pid ${P}）" || echo "不在")"
fi

# ── 4. 在组里却没有收件程序 → 一律出声，不看有没有未读 ──
#
# ⚠️ 这条判据改过。原先是「**有未读** + 程序不在」才出声，理由写的是
#    「没有消息等着的时候，它不在是正确状态，省资源」。**那个理由把场景弄反了，而且真出过事。**
#
# 出的什么事（2026-08-14 实测复现）：
#   人恢复一个会话 → 本钩子确实跑了（它挂在 SessionStart 上）→ **但那一刻信箱是空的**
#   （上一轮消息已经处理完并删掉了）→ 按老判据「没有活要干」→ 静默 → 收件程序没起。
#   随后给那个会话发了一条消息，**它躺在信箱里五分钟没有任何动静** ——
#   收件程序不在，消息推不进对话流；而本钩子**只在「会话启动」和「人敲字」两个时机跑**，
#   没有第三个触发点。**于是那个会话一直是聋的，直到有人去它窗口敲一个字为止。**
#
# 判据错在哪：「没有消息等着就不必有人守」——**这话对已关闭的窗口成立，对活着的会话不成立。**
#   收件程序的作用**就是在消息到来之前守着**。等消息堆起来再靠人敲字唤醒，
#   「自动收消息」这件事本身就不成立了。
#
# 为什么不必心疼资源：它 5 秒扫一次文件、不思考、不花词元，成本近似为零。
#   空转一小时自动下班那个机制，**要防的是窗口关掉之后留下的孤儿进程**
#   （那种情况本钩子根本不会再跑，也就不会被重新拉起），**不是防它开着**。
#   **会话还活着 = 本钩子还会跑 = 它就该有一个在听。**
#
# ❗️ 以后谁想按「省资源」把这条改回「只在有未读时出声」，先看上面这段。
#    自测里有两项专门守着这个行为（空信箱也必须出声）。
if [ "$ALIVE" -eq 0 ]; then
  # 身份说明：在组里就报组名；只有代号（接入了传话台但没进组）就说代号
  if [ -n "$MYGROUPS" ]; then
    WHO="你在讨论组【${MYGROUPS}】里"
  else
    WHO="这个窗口有代号【${MYALIAS}】（也就是接入了传话台，别人随时可能传话给你）"
  fi
  if [ "$N" -gt 0 ]; then
    echo "🔔 ${WHO}，**收件箱有 ${N} 条消息没处理，而且收件程序不在岗**。"
    echo "   先把它起起来，再按值班守则逐条处理这些消息。"
  else
    echo "🔔 ${WHO}，但**收件程序不在岗**（信箱现在是空的）。"
    echo "   **别因为「现在没消息」就不起它** —— 它的作用正是在消息到来之前守着。"
    echo "   不起的话，之后进来的消息**不会有任何动静**，要等人去这个窗口敲字才会被发现。"
    echo "   另外：收件程序不在岗时，你在别人的地址簿里显示为「离线」，传话根本发不过来。"
  fi
  echo
  echo "   用盯梢工具（Monitor）起它："
  echo "     命令：${SKILL_DIR}/bin/watcher.sh"
  echo "     persistent：true"
  echo "     描述：本会话收件箱的新消息"
  echo
  echo "   （这一步脚本做不了 —— 它要把消息推进对话流，只有会话用盯梢工具起的进程才行。）"
  exit 0
fi

[ "$VERBOSE" = 1 ] && echo "→ 静默：收件程序在岗（pid ${P}），一切正常"
exit 0
